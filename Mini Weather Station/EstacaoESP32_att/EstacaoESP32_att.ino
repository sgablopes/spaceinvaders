#include <DHT.h>
#include <Preferences.h>
#include <WebServer.h>
#include <WiFi.h>

#include <esp_http_client.h>
#include <esp_idf_version.h>
#include <freertos/FreeRTOS.h>
#include <freertos/queue.h>
#include <freertos/task.h>
#include <time.h>

#include <atomic>
#include <cmath>
#include <cstring>

constexpr char ESPACO_WIFI[] = "estacao-wifi";
constexpr char CHAVE_WIFI[] = "rede";
constexpr size_t LIMITE_SSID = 32;
constexpr size_t LIMITE_SENHA = 64;
constexpr char ROTA_SENSORES[] = "/sensores";

constexpr char AGRION_URL[] = "https://agrion.earth/api/v1/stations/telemetry";
constexpr char AGRION_DEMO_ID[] = "agrion-demo-001";
constexpr const char* AGRION_STATION_ID = AGRION_DEMO_ID;
constexpr char AGRION_STATION_KEY[] = "";
constexpr uint32_t INTERVALO_AGRION_MS = 5000;
constexpr int AGRION_TIMEOUT_HTTP_MS = 3500;
constexpr size_t AGRION_LIMITE_RESPOSTA = 768;
constexpr time_t AGRION_EPOCA_MINIMA = 1704067200;

// Preencha com a raiz do servidor se usar outra cadeia de certificados.
constexpr char AGRION_CA_PERSONALIZADA[] = "";
extern const char AGRION_CA_RAIZES[];

// Pinagem da DevKit com ESP32-WROOM-32.
constexpr uint8_t PINO_YL38 = 26;
constexpr uint8_t PINO_DHT22 = 27;
constexpr uint8_t PINO_MOTOR = 35;

// Nível do D0 com a placa de chuva molhada.
constexpr int NIVEL_MOLHADO_YL38 = LOW;

constexpr uint32_t INTERVALO_DHT_MS = 2000;
constexpr uint32_t INTERVALO_RECONEXAO_MS = 30000;
constexpr uint32_t INTERVALO_PROMPT_MS = 8000;
constexpr uint8_t RESOLUCAO_ADC_BITS = 12;
constexpr uint8_t AMOSTRAS_MOTOR = 64;
constexpr uint32_t INTERVALO_MOTOR_SERIAL_MS = 1000;

// Referência do ensaio com ventilador.
constexpr float ADC_INICIO_ESCALA_VENTO = 0.0f;
constexpr float ADC_REFERENCIA_VENTO = 450.0f;
constexpr float VENTO_REFERENCIA_MS = 4.0f;
static_assert(ADC_REFERENCIA_VENTO > ADC_INICIO_ESCALA_VENTO, "Referencia ADC invalida.");

DHT dht(PINO_DHT22, DHT22);
WebServer servidor(80);

uint32_t ultimaLeituraDhtMs = 0;
uint32_t ultimaTentativaWifiMs = 0;
float temperaturaC = NAN;
float umidadePct = NAN;
bool servidorAtivo = false;

struct AmostraSensores {
  float temperaturaC;
  float umidadePct;
  int nivelYl38;
  float motorAdcRaw;

  bool chuvaDetectada() const {
    return nivelYl38 == NIVEL_MOLHADO_YL38;
  }
};

struct AmostraAgrion {
  AmostraSensores sensores;
  uint32_t ventoMv;
};

struct LogHttpAgrion {
  char corpo[AGRION_LIMITE_RESPOSTA + 1] = {};
  size_t tamanho = 0;
  bool excedeuLimite = false;
  const char* etapa = "preparacao";
};

AmostraSensores lerSensores();
void anexarCamposSensoresJson(String& json, const AmostraSensores& leitura);
String montarTelemetriaAgrion(const AmostraAgrion& leitura);
void enviarTelemetriaAgrion(const AmostraAgrion& leitura);

QueueHandle_t filaAgrion = nullptr;
uint32_t ultimoCicloAgrionMs = 0;
bool avisouHoraAgrion = false;

enum class EntradaWifi { Nenhuma, Ssid, Senha };
EntradaWifi entradaWifi = EntradaWifi::Nenhuma;
String ssidWifi;
String senhaWifi;
uint32_t ultimoPromptMs = 0;
bool salvarWifiAoConectar = false;

// O callback de Wi-Fi roda em outra tarefa.
constexpr int WIFI_SEM_EVENTO = -1;
constexpr int WIFI_ASSOCIADO = 0;
std::atomic<int> diagnosticoWifi{WIFI_SEM_EVENTO};
int ultimoDiagnosticoMostrado = WIFI_SEM_EVENTO;

void atualizarDht() {
  const uint32_t agora = millis();
  if (agora - ultimaLeituraDhtMs < INTERVALO_DHT_MS) {
    return;
  }

  ultimaLeituraDhtMs = agora;
  temperaturaC = dht.readTemperature();
  umidadePct = dht.readHumidity();
}

float lerMotorAdcRaw() {
  uint32_t somaContagens = 0;
  for (uint8_t i = 0; i < AMOSTRAS_MOTOR; ++i) {
    somaContagens += analogRead(PINO_MOTOR);
    delay(1);
  }
  return static_cast<float>(somaContagens) / AMOSTRAS_MOTOR;
}

float estimarVentoMs(float adcRaw) {
  const float contagens = std::fmax(0.0f, adcRaw - ADC_INICIO_ESCALA_VENTO);
  const float contagensReferencia = ADC_REFERENCIA_VENTO - ADC_INICIO_ESCALA_VENTO;
  return VENTO_REFERENCIA_MS * (contagens / contagensReferencia);
}

void mostrarMotorSerial() {
  static uint32_t ultimaLeituraMs = 0;
  const uint32_t agora = millis();
  if (agora - ultimaLeituraMs < INTERVALO_MOTOR_SERIAL_MS) {
    return;
  }
  ultimaLeituraMs = agora;

  const float adcRaw = lerMotorAdcRaw();
  Serial.print("GPIO");
  Serial.print(PINO_MOTOR);
  Serial.print(" ADC: ");
  Serial.print(adcRaw, 3);
  Serial.print(" contagens | vento estimado: ");
  Serial.print(estimarVentoMs(adcRaw), 1);
  Serial.println(" m/s");
}

void escreverNumeroJson(String& json, float valor, uint8_t casasDecimais) {
  if (std::isfinite(valor)) {
    json += String(valor, static_cast<unsigned int>(casasDecimais));
  } else {
    json += "null";
  }
}

AmostraSensores lerSensores() {
  atualizarDht();
  return {
    temperaturaC,
    umidadePct,
    digitalRead(PINO_YL38),
    lerMotorAdcRaw(),
  };
}

void anexarCamposSensoresJson(String& json, const AmostraSensores& leitura) {
  json += ",\"yl38_d0\":";
  json += String(leitura.nivelYl38);
  json += ",\"motor_adc_raw\":";
  escreverNumeroJson(json, leitura.motorAdcRaw, 3);
  json += ",\"vento_estimado_m_s\":";
  escreverNumeroJson(json, estimarVentoMs(leitura.motorAdcRaw), 1);
}

void responderSensores() {
  const AmostraSensores leitura = lerSensores();

  String json;
  json.reserve(290);
  json += "{\"temperatura_c\":";
  escreverNumeroJson(json, leitura.temperaturaC, 1);
  json += ",\"umidade_relativa_pct\":";
  escreverNumeroJson(json, leitura.umidadePct, 1);
  json += ",\"chuva_detectada\":";
  json += (leitura.chuvaDetectada() ? "true" : "false");
  anexarCamposSensoresJson(json, leitura);
  json += "}";

  servidor.sendHeader("Cache-Control", "no-store");
  servidor.send(200, "application/json", json);
}

void escreverStringJson(String& json, const char* texto) {
  constexpr char hex[] = "0123456789abcdef";
  json += '"';
  while (*texto) {
    const uint8_t c = static_cast<uint8_t>(*texto++);
    if (c == '"' || c == '\\') {
      json += '\\';
      json += static_cast<char>(c);
    } else if (c < 0x20) {
      json += "\\u00";
      json += hex[c >> 4];
      json += hex[c & 0x0f];
    } else {
      json += static_cast<char>(c);
    }
  }
  json += '"';
}

bool agrionUsaChave() {
  return std::strcmp(AGRION_STATION_ID, AGRION_DEMO_ID) != 0;
}

bool agrionConfigurado() {
  return AGRION_STATION_ID[0] && (!agrionUsaChave() || AGRION_STATION_KEY[0]);
}

String montarTelemetriaAgrion(const AmostraAgrion& leitura) {
  const AmostraSensores& sensores = leitura.sensores;
  String json;
  json.reserve(320);
  json += "{\"station_id\":";
  escreverStringJson(json, AGRION_STATION_ID);
  json += ",\"measurements\":{\"rain_detected\":";
  json += (sensores.chuvaDetectada() ? "true" : "false");
  json += ",\"wind_voltage_mv\":";
  json += String(leitura.ventoMv);

  if (std::isfinite(sensores.temperaturaC)) {
    json += ",\"temperature_c\":";
    escreverNumeroJson(json, sensores.temperaturaC, 1);
  }
  if (std::isfinite(sensores.umidadePct)) {
    json += ",\"humidity_pct\":";
    escreverNumeroJson(json, sensores.umidadePct, 1);
  }
  anexarCamposSensoresJson(json, sensores);
  json += "}}";
  return json;
}

esp_err_t registrarEventoHttpAgrion(esp_http_client_event_t* evento) {
  auto& log = *static_cast<LogHttpAgrion*>(evento->user_data);
  if (evento->event_id == HTTP_EVENT_ON_CONNECTED) {
    log.etapa = "envio HTTP";
  } else if (evento->event_id == HTTP_EVENT_HEADERS_SENT) {
    log.etapa = "corpo do POST ou resposta HTTP";
  } else if (evento->event_id == HTTP_EVENT_ON_DATA && evento->data_len > 0) {
    const size_t recebido = static_cast<size_t>(evento->data_len);
    const size_t livre = AGRION_LIMITE_RESPOSTA - log.tamanho;
    const size_t copiar = recebido < livre ? recebido : livre;
    std::memcpy(log.corpo + log.tamanho, evento->data, copiar);
    log.tamanho += copiar;
    log.corpo[log.tamanho] = '\0';
    if (copiar < recebido) {
      log.excedeuLimite = true;
    }
  }
  return ESP_OK;
}

String textoAgrionParaSerial(const char* texto) {
  String resultado(texto);
  if (AGRION_STATION_KEY[0]) {
    resultado.replace(AGRION_STATION_KEY, "[chave omitida]");
    String chaveJson;
    escreverStringJson(chaveJson, AGRION_STATION_KEY);
    chaveJson = chaveJson.substring(1, chaveJson.length() - 1);
    if (chaveJson.length() && std::strcmp(chaveJson.c_str(), AGRION_STATION_KEY) != 0) {
      resultado.replace(chaveJson, "[chave omitida]");
    }
  }
  resultado.replace("\r", " ");
  resultado.replace("\n", " ");
  return resultado;
}

void enviarTelemetriaAgrion(const AmostraAgrion& leitura) {
  static unsigned long contador = 0;
  const unsigned long tentativa = ++contador;
  const uint32_t inicioMs = millis();
  const String json = montarTelemetriaAgrion(leitura);
  LogHttpAgrion log;
  esp_http_client_config_t config = {};
  config.url = AGRION_URL;
  config.method = HTTP_METHOD_POST;
  config.cert_pem = AGRION_CA_PERSONALIZADA[0] ? AGRION_CA_PERSONALIZADA : AGRION_CA_RAIZES;
  config.timeout_ms = AGRION_TIMEOUT_HTTP_MS;
  config.disable_auto_redirect = true;
  config.event_handler = registrarEventoHttpAgrion;
  config.user_data = &log;

  esp_http_client_handle_t cliente = esp_http_client_init(&config);
  if (cliente == nullptr) {
    Serial.printf("Agrion: #%lu falha ao iniciar o cliente HTTPS.\n", tentativa);
    return;
  }

  esp_err_t erro = esp_http_client_set_header(cliente, "Content-Type", "application/json");
  if (erro == ESP_OK && agrionUsaChave()) {
    erro = esp_http_client_set_header(cliente, "X-Station-Key", AGRION_STATION_KEY);
  }
  if (erro == ESP_OK) {
    erro = esp_http_client_set_post_field(cliente, json.c_str(), json.length());
  }
  const bool iniciouPost = (erro == ESP_OK);
  if (iniciouPost) {
    const String numero(tentativa);
    String bloco;
    bloco.reserve(json.length() + 220);
    bloco += "Agrion: POST #";
    bloco += numero;
    bloco += ' ';
    bloco += AGRION_URL;
    bloco += "\nAgrion: Content-Type: application/json";
    if (agrionUsaChave()) {
      bloco += "\nAgrion: X-Station-Key: [chave omitida]";
    }
    bloco += "\nAgrion: JSON #";
    bloco += numero;
    bloco += ' ';
    bloco += textoAgrionParaSerial(json.c_str());
    Serial.println(bloco.c_str());
    log.etapa = "conexao HTTPS";
    erro = esp_http_client_perform(cliente);
  }

  const int status = esp_http_client_get_status_code(cliente);
  const unsigned long decorrido = static_cast<unsigned long>(millis() - inicioMs);
  if (erro != ESP_OK) {
    Serial.printf("Agrion: %s. #%lu em %lu ms, etapa=%s, HTTP=%d, errno=%d.\n",
                  esp_err_to_name(erro), tentativa, decorrido, log.etapa, status,
                  iniciouPost ? esp_http_client_get_errno(cliente) : 0);
#if ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 5, 0)
    if (iniciouPost) {
      int erroTls = 0;
      int flagsTls = 0;
      const esp_err_t codigoTls = esp_http_client_get_and_clear_last_tls_error(cliente, &erroTls, &flagsTls);
      if (codigoTls != ESP_OK || erroTls != 0 || flagsTls != 0) {
        Serial.printf("Agrion: TLS #%lu codigo=%s, mbedTLS=%d, flags=0x%x.\n",
                      tentativa, esp_err_to_name(codigoTls), erroTls, static_cast<unsigned>(flagsTls));
      }
    }
#endif
  } else {
    Serial.printf("Agrion: HTTP %d. #%lu em %lu ms.\n", status, tentativa, decorrido);
  }
  esp_http_client_cleanup(cliente);

  if (log.excedeuLimite) {
    Serial.printf("Agrion: resposta #%lu acima de %u bytes.\n", tentativa,
                  static_cast<unsigned>(AGRION_LIMITE_RESPOSTA));
  } else if (erro == ESP_OK && log.tamanho) {
    const String corpoParaSerial = textoAgrionParaSerial(log.corpo);
    Serial.printf("Agrion: resposta #%lu %s\n", tentativa, corpoParaSerial.c_str());
  } else if (erro == ESP_OK) {
    Serial.printf("Agrion: resposta #%lu sem corpo.\n", tentativa);
  } else if (log.tamanho) {
    Serial.printf("Agrion: resposta #%lu interrompida apos %u bytes.\n", tentativa,
                  static_cast<unsigned>(log.tamanho));
  }
  if (erro != ESP_OK || status != 201) {
    Serial.println("Agrion: nova tentativa no proximo ciclo.");
  }
}

void tarefaAgrion(void*) {
  AmostraAgrion leitura;
  for (;;) {
    if (xQueueReceive(filaAgrion, &leitura, portMAX_DELAY) != pdTRUE) {
      continue;
    }
    if (WiFi.status() != WL_CONNECTED) {
      Serial.println("Agrion: envio adiado. Wi-Fi desconectado.");
    } else if (time(nullptr) < AGRION_EPOCA_MINIMA) {
      Serial.println("Agrion: envio adiado. Aguardando hora de rede.");
    } else {
      enviarTelemetriaAgrion(leitura);
    }
  }
}

void iniciarAgrion() {
  if (!agrionConfigurado()) {
    Serial.println("Agrion: preencha AGRION_STATION_ID e AGRION_STATION_KEY.");
    return;
  }

  filaAgrion = xQueueCreate(1, sizeof(AmostraAgrion));
  if (filaAgrion &&
      xTaskCreate(tarefaAgrion, "agrion", 10240, nullptr, 1, nullptr) == pdPASS) {
    Serial.printf("Agrion: destino %s, intervalo de %u s. Aguardando Wi-Fi.\n",
                  AGRION_URL, static_cast<unsigned>(INTERVALO_AGRION_MS / 1000));
    return;
  }
  if (filaAgrion) {
    vQueueDelete(filaAgrion);
    filaAgrion = nullptr;
  }
  Serial.println("Agrion: falha ao iniciar a tarefa de telemetria.");
}

uint32_t lerTensaoGeradorMv() {
  uint32_t somaMv = 0;
  for (uint8_t i = 0; i < AMOSTRAS_MOTOR; ++i) {
    somaMv += analogReadMilliVolts(PINO_MOTOR);
    delay(1);
  }
  return (somaMv + AMOSTRAS_MOTOR / 2u) / AMOSTRAS_MOTOR;
}

void agendarTelemetriaAgrion() {
  const uint32_t agora = millis();
  if (agora - ultimoCicloAgrionMs < INTERVALO_AGRION_MS) {
    return;
  }
  ultimoCicloAgrionMs = agora;

  if (!agrionConfigurado()) {
    Serial.println("Agrion: POST pendente. Preencha AGRION_STATION_ID e AGRION_STATION_KEY.");
    return;
  }
  if (!filaAgrion) {
    Serial.println("Agrion: POST pendente. Tarefa de telemetria indisponivel.");
    return;
  }
  if (entradaWifi != EntradaWifi::Nenhuma || WiFi.status() != WL_CONNECTED) {
    Serial.println("Agrion: POST pendente. Aguardando Wi-Fi.");
    return;
  }
  if (time(nullptr) < AGRION_EPOCA_MINIMA) {
    Serial.println("Agrion: POST pendente. Aguardando hora de rede para validar HTTPS.");
    avisouHoraAgrion = true;
    return;
  }

  if (avisouHoraAgrion) {
    Serial.println("Agrion: hora disponivel. Envio HTTPS liberado.");
    avisouHoraAgrion = false;
  }

  const AmostraAgrion leitura{lerSensores(), lerTensaoGeradorMv()};
  // A fila conserva a amostra mais recente se um envio atrasar.
  xQueueOverwrite(filaAgrion, &leitura);
}

bool carregarWifiSalvo() {
  Preferences preferencias;
  if (!preferencias.begin(ESPACO_WIFI, true)) {
    return false;
  }

  const String registro = preferencias.getString(CHAVE_WIFI, "");
  preferencias.end();
  const int separador = registro.indexOf('\n');
  if (separador <= 0 || static_cast<size_t>(separador) > LIMITE_SSID) {
    return false;
  }

  ssidWifi = registro.substring(0, separador);
  senhaWifi = registro.substring(separador + 1);
  return senhaWifi.length() <= LIMITE_SENHA;
}

bool salvarWifi() {
  Preferences preferencias;
  if (!preferencias.begin(ESPACO_WIFI)) {
    return false;
  }

  // Grava SSID e senha juntos.
  String registro = ssidWifi;
  registro += '\n';
  registro += senhaWifi;
  const bool salvou = preferencias.putString(CHAVE_WIFI, registro) == registro.length();
  preferencias.end();
  return salvou;
}

void mostrarPromptWifi() {
  if (entradaWifi == EntradaWifi::Ssid) {
    Serial.println("Digite o SSID (nome da rede) e pressione Enter:");
  } else {
    Serial.println("Digite a senha do Wi-Fi e pressione Enter:");
  }
  ultimoPromptMs = millis();
}

void pedirSsidWifi() {
  if (servidorAtivo) {
    servidor.stop();
    servidorAtivo = false;
  }
  WiFi.setAutoReconnect(false);
  WiFi.disconnect();
  salvarWifiAoConectar = false;
  entradaWifi = EntradaWifi::Ssid;
  mostrarPromptWifi();
}

void registrarEventoWifi(WiFiEvent_t evento, WiFiEventInfo_t info) {
  if (evento == ARDUINO_EVENT_WIFI_STA_CONNECTED) {
    diagnosticoWifi.store(WIFI_ASSOCIADO);
  } else if (evento == ARDUINO_EVENT_WIFI_STA_DISCONNECTED) {
    diagnosticoWifi.store(info.wifi_sta_disconnected.reason);
  }
}

void mostrarProgressoWifi() {
  const int estado = diagnosticoWifi.load();
  if (estado == ultimoDiagnosticoMostrado) {
    return;
  }
  ultimoDiagnosticoMostrado = estado;

  if (estado == WIFI_ASSOCIADO) {
    Serial.println("Wi-Fi associado ao roteador. Aguardando IPv4 (DHCP).");
  } else if (estado > WIFI_ASSOCIADO) {
    Serial.print("Wi-Fi: codigo de desconexao ");
    Serial.println(estado);
  }
}

void mostrarTempoLimiteWifi() {
  const int estado = diagnosticoWifi.load();
  if (estado == WIFI_ASSOCIADO) {
    Serial.println("Tempo limite: associado ao roteador, sem IPv4. Confira o DHCP.");
  } else if (estado > WIFI_ASSOCIADO) {
    Serial.print("Tempo limite de conexao. Ultimo codigo de desconexao: ");
    Serial.println(estado);
  } else {
    Serial.println("Tempo limite de conexao. O ESP32 nao recebeu evento de associacao.");
  }
}

void conectarWifi(bool gravarAoConectar) {
  entradaWifi = EntradaWifi::Nenhuma;
  salvarWifiAoConectar = gravarAoConectar;
  diagnosticoWifi.store(WIFI_SEM_EVENTO);
  ultimoDiagnosticoMostrado = WIFI_SEM_EVENTO;
  Serial.print("Conectando ao SSID [");
  Serial.print(ssidWifi.c_str());
  Serial.println("]...");
  WiFi.setAutoReconnect(true);
  WiFi.begin(ssidWifi.c_str(), senhaWifi.length() ? senhaWifi.c_str() : nullptr);
  ultimaTentativaWifiMs = millis();
}

void lerConfiguracaoWifi() {
  if (!Serial.available()) {
    return;
  }

  String linha = Serial.readStringUntil('\n');
  if (linha.endsWith("\r")) {
    linha.remove(linha.length() - 1);
  }

  if (entradaWifi == EntradaWifi::Ssid) {
    if (linha.length() == 0 || linha.length() > LIMITE_SSID) {
      Serial.println("Use um SSID de 1 a 32 bytes.");
    } else {
      ssidWifi = linha;
      entradaWifi = EntradaWifi::Senha;
    }
    mostrarPromptWifi();
    return;
  }

  if (entradaWifi == EntradaWifi::Senha) {
    if (linha.length() > LIMITE_SENHA) {
      Serial.println("A senha deve ter no maximo 64 bytes.");
      mostrarPromptWifi();
      return;
    }
    senhaWifi = linha;
    conectarWifi(true);
    return;
  }

  linha.trim();
  if (linha.equalsIgnoreCase("wifi")) {
    pedirSsidWifi();
  }
}

void setup() {
  Serial.begin(115200);
  Serial.setTimeout(250);
  pinMode(PINO_YL38, INPUT);
  analogReadResolution(RESOLUCAO_ADC_BITS);
  analogSetPinAttenuation(PINO_MOTOR, ADC_11db);
  dht.begin();
  ultimaLeituraDhtMs = millis();

  servidor.on(ROTA_SENSORES, HTTP_GET, responderSensores);
  servidor.onNotFound([]() {
    servidor.send(404, "application/json", "{\"erro\":\"rota_nao_encontrada\"}");
  });

  iniciarAgrion();
  WiFi.onEvent(registrarEventoWifi);
  WiFi.persistent(false);
  WiFi.mode(WIFI_STA);
  if (carregarWifiSalvo()) {
    conectarWifi(false);
  } else {
    pedirSsidWifi();
  }
}

void loop() {
  lerConfiguracaoWifi();

  if (entradaWifi != EntradaWifi::Nenhuma) {
    if (millis() - ultimoPromptMs >= INTERVALO_PROMPT_MS) {
      mostrarPromptWifi();
    }
  } else if (WiFi.status() == WL_CONNECTED) {
    if (!servidorAtivo) {
      if (salvarWifiAoConectar) {
        salvarWifiAoConectar = false;
        if (!salvarWifi()) {
          Serial.println("Wi-Fi conectado. Falha ao salvar a rede na placa.");
        }
      }
      servidor.begin();
      servidorAtivo = true;
      if (filaAgrion) {
        configTime(0, 0, "pool.ntp.org", "time.google.com");
        ultimoCicloAgrionMs = millis() - INTERVALO_AGRION_MS;
        avisouHoraAgrion = false;
      }
      Serial.print("GET http://");
      Serial.print(WiFi.localIP());
      Serial.println(ROTA_SENSORES);
      Serial.println("Para trocar de rede, envie wifi pelo Monitor Serial.");
    }
    servidor.handleClient();
  } else {
    if (servidorAtivo) {
      servidor.stop();
      servidorAtivo = false;
      ultimaTentativaWifiMs = millis();
      Serial.println("Wi-Fi desconectado.");
    }
    mostrarProgressoWifi();
    if (millis() - ultimaTentativaWifiMs >= INTERVALO_RECONEXAO_MS) {
      mostrarTempoLimiteWifi();
      if (salvarWifiAoConectar) {
        pedirSsidWifi();
      } else {
        ultimaTentativaWifiMs = millis();
        WiFi.reconnect();
        Serial.println("Tentando reconectar. Envie wifi para trocar de rede.");
      }
    }
  }

  agendarTelemetriaAgrion();
  mostrarMotorSerial();
  delay(2);
}

