# Somente nomes de configuração; não preencha nem versione segredos neste exemplo.
# Alternativa pública Open-Meteo (uso não comercial): timeout 30 s, cache 300 s/64 entradas, horizonte 7 dias.
# OPEN_METEO_TIMEOUT_SECONDS, OPEN_METEO_CACHE_TTL_SECONDS, OPEN_METEO_CACHE_ENTRIES, OPEN_METEO_MAX_FORECAST_DAYS
# Configure valores reais pelo ambiente do processo/secret manager do ambiente de execução.
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=
METEOMATICS_TIMEOUT_SECONDS=30
METEOMATICS_MAX_RETRIES=1
METEOMATICS_CACHE_TTL_SECONDS=300
METEOMATICS_CACHE_ENTRIES=64
METEOMATICS_MAX_FORECAST_DAYS=7
AQUACROP_TIMEOUT_SECONDS=90
